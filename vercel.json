{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/parana",
      "dest": "/api/parana"
    },
    {
      "src": "/api/riesgo",
      "dest": "/api/riesgo"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
